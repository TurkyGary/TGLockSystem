#!/bin/bash
PORT="/dev/ttyACM0"
TEMP_FILE=$TGLOCKSYS/logs/access/read.tmp
RAW=''

function readCard(){
 proxmark3 -p $PORT -c "lf io read" |grep "IO" | sed "s/+/$(date '+%Y%b%d_%H%M%S'|tr '[:lower:]' '[:upper:]')/"> $TGLOCKSYS/logs/access/read.tmp
}

function getCardRaw(){
 RAW=$(grep -oP '(?<=Raw: ).{16}' "$TEMP_FILE")
 echo $RAW
}

function readCardRaw(){
 python3 "$TGLOCKSYS/misc/scripts/readerLED.py" BLED_on 1 &
 readCard
 getCardRaw
 if [[ -z "$RAW" || "$RAW" == +([[:space:]]) ]];then
     # Fail feedback signals
     python3 "$TGLOCKSYS/misc/scripts/buzzer.py" cardRead_fail &
     python3 "$TGLOCKSYS/misc/scripts/readerLED.py" RLED_blink 4 &
 else
     # Success feedback signals
     python3 "$TGLOCKSYS/misc/scripts/buzzer.py" cardRegister &
     python3 "$TGLOCKSYS/misc/scripts/readerLED.py" BLED_blink 4 &
 fi
 echo $RAW
}

function card_register() {
    local HID=$HID
    local HNAME=$HNAME

    # Check if arguments are provided
    if [[ -z "$HID" || -z "$HNAME" ]]; then
        echo "Usage: readIDcard <HID> <HNAME>"
        return 1
    fi

    echo -e "Place your card on the reader and press Enter... \c"
    read -r tmpIGNORE
    echo "Reading ID Card..."
    
    # Execute the read command
    readCard

    # Check for success in the log file
    if grep -q 'ok' "$TGLOCKSYS/logs/access/read.tmp"; then
        # Process card data
        record=$(sed "s/-/,/g" "$TGLOCKSYS/logs/access/read.tmp" | tr -d ' ')
        getCardRaw
        raw=$RAW

        # Update data files
        echo "${HID},${raw}" >> "$TGLOCKSYS/data/access_list.csv"
        echo "${HID}" >> "$TGLOCKSYS/data/granted.csv"
        
        # Log the transaction
        record+=",${HID},${HNAME}"
        echo "$record" >> "$TGLOCKSYS/data/.bkp.log"

        echo "New card has been added. Access has been granted."

        # Success feedback signals
        python3 "$TGLOCKSYS/misc/scripts/buzzer.py" cardRegister &
        python3 "$TGLOCKSYS/misc/scripts/readerLED.py" BLED_blink 4 &
    else
        echo "Cannot read your card. Try again."
        python3 "$TGLOCKSYS/misc/scripts/buzzer.py" cardRead_fail &
        return 1
    fi
}

