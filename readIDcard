#!/bin/bash
PORT="/dev/ttyACM0"
TEMP_FILE=$TGLOCKSYS/logs/access/read.tmp

function readCard(){
#while true
#do
proxmark3 -p $PORT -c "lf io read" |grep "IO" | sed "s/+/$(date '+%Y%b%d_%H%M%S'|tr '[:lower:]' '[:upper:]')/"> $TGLOCKSYS/logs/access/read.tmp
#sleep 3
#done
}
if [ $# -lt 1 ];then
# read card from reader
readCard
#python $TGLOCKSYS/misc/scripts/readerLED.py BLED_blink 1

# check that the card read is correct 
confirmIDcard

else if [ $# -gt 0 ] && [ $# -lt 4 ];then
if [ $# -eq 1 ];then
if [ $1 == "-h" ] || [ $1 == "--help" ];then
echo -e "Usage: readIDcard [OPTION]... [ARGUMENTS]...\nRead ID cards and register new cards to the system\nOPTION:\n   -h   --help\tshow command help.\n   register\tadd new card to the system.\nARGUMENTS:\n\tHolder_ID\tIdentification number of the card holder.\n\tHolder_Name\tFull name of the card holder."
fi
if [ $1 == "register" ];then
python $TGLOCKSYS/misc/scripts/readerLED.py BLED_ON &
python $TGLOCKSYS/misc/scripts/buzzer.py cardRead_success &
echo -e "Enter Card Holder ID: \c"
read HID
echo -e "Enter Card Holder Full Name: \c"
read HNAME
echo -e "Place your card on the reader and press Enter<Return>... \c"
read tmpIGNORE
echo "Reading ID Card..."
readCard
if grep -q 'ok' $TGLOCKSYS/logs/access/read.tmp;then
record=`sed "s/-/,/g" $TGLOCKSYS/logs/access/read.tmp | tr -d ' '`
raw=$(grep -oP '(?<=Raw: ).{16}' $TEMP_FILE)
echo $HID','$raw >> $TGLOCKSYS/data/access_list.csv
echo "New card has been added."
record+=",$HID,$HNAME"
echo $record >> $TGLOCKSYS/data/.bkp.log
echo $HID >> $TGLOCKSYS/data/granted.csv
echo "Access has been granted."
python $TGLOCKSYS/misc/scripts/buzzer.py cardRegister &
python $TGLOCKSYS/misc/scripts/readerLED.py BLED_blink 4 &
else
echo "Can not read your card, Try again."
python $TGLOCKSYS/misc/scripts/buzzer.py cardRead_fail &
fi
fi
fi
if [ $# -eq 2 ];then
echo "two: $@"
fi
if [ $# -eq 3 ];then
echo "three: $@"
fi
fi
fi 
